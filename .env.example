# Salin ke .env untuk preview lokal. Jangan commit nilai rahasia.
# Untuk produksi, atur variabel ini di Sites > Settings > Environment variables.

# Midtrans (wajib untuk QRIS produksi)
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Email OTP reset password. Domain pengirim harus sudah aktif di Cloudflare Email Sending.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_TOKEN=
RESET_FROM_EMAIL=noreply@domain-anda.com

# Hanya untuk preview lokal; kode OTP dikembalikan ke UI jika email belum dikonfigurasi.
RESET_EMAIL_DEV_MODE=true

# Preview lokal (opsional)
# CLOUDFLARE_CF_FETCH_ENABLED=false
# WRANGLER_SEND_METRICS=false
